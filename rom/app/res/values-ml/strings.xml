    <string name="spoof_props_summary">സിസ്‌റ്റം പ്രോപ്പർട്ടികൾ സ്‌പൂഫ് ചെയ്യുക.</string>
    <string name="spoof_provider_title">പ്രൊവൈഡർ സ്‌പൂഫ് ചെയ്യുക</string>
