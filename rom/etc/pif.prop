# Options of the Play Integrity Fix shipped with the ROM (GPL-3.0, see LICENSE), after
# module/pif.prop of KOWX712/PlayIntegrityFix v4.9-inject-s. The device profile
# (FINGERPRINT, MANUFACTURER, MODEL, SECURITY_PATCH, DEVICE_INITIAL_SDK_INT) is not
# shipped: the Play Integrity Fix app fetches it on first run and stores it in
# Settings.Global. spoofProvider is skipped while the ROM's own keybox is set;
# spoofVendingBuild gives the Play Store the same build as Droidguard, like the module.
spoofBuild=true
spoofProps=true
spoofProvider=true
spoofSignature=false
spoofVendingBuild=true
spoofVendingSdk=false
DEBUG=false
