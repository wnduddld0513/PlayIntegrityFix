//
// Specter for the PixelOS spoofing (Settings > System > Developer options > Play Integrity
// spoofing): PixelOS applies the Play Integrity profile and signs the key attestation with
// the keybox itself; this app sets them up on a fresh install and keeps them up to date.
//   PlayIntegrityFixSettings the Specter page (Experimental features app) and its passes
//

android_app {
    name: "PlayIntegrityFixSettings",

    srcs: ["rom/app/src/**/*.java"],
    manifest: "rom/app/AndroidManifest.xml",
    resource_dirs: ["rom/app/res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
    ],

    required: ["privapp-permissions-pif.xml"],

    optimize: {
        proguard_flags_files: ["rom/app/proguard.flags"],
    },
}

prebuilt_etc {
    name: "privapp-permissions-pif.xml",
    src: "rom/app/privapp-permissions-pif.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
